{
  "name": "draft-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && npm run test:data",
    "data:collect": "node --env-file-if-exists=.env scripts/riot/cli.mjs collect",
    "data:status": "node scripts/riot/cli.mjs status",
    "data:export": "node scripts/riot/cli.mjs export",
    "data:rebuild": "node scripts/riot/cli.mjs rebuild",
    "data:prepare": "node scripts/riot/cli.mjs prepare",
    "test:data": "node --test scripts/riot/tests/*.node-test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  }
}
